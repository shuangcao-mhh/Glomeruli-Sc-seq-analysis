seu_wt <- JoinLayers(seu_wt)
Layers(seu_wt)
rownames(seu_wt@meta.data) <- colnames(seu_wt)

# VF Processing
seu_vf <- subset(seu_integrated, subset = genotype == "VF")
seu_vf <- subset(seu_vf, idents = c("MC", "POD", "GEC", "vSMC"))
seu_vf <- JoinLayers(seu_vf)
Layers(seu_vf)
rownames(seu_vf@meta.data) <- colnames(seu_vf)

# Creat cellchat object
cellchat_wt <- createCellChat(object = seu_wt, group.by = "celltype")
cellchat_vf <- createCellChat(object = seu_vf, group.by = "celltype")

#check the info is correct 
print(nrow(cellchat_wt@meta))
print(nrow(cellchat_vf@meta))

table(cellchat_wt@idents)
table(cellchat_vf@idents)

cellchat_wt@DB <- CellChatDB.mouse
cellchat_vf@DB <- CellChatDB.mouse

cellchat_wt <- subsetData(cellchat_wt)
cellchat_wt <- identifyOverExpressedGenes(cellchat_wt)
cellchat_wt <- identifyOverExpressedInteractions(cellchat_wt)
cellchat_wt <- computeCommunProb(cellchat_wt)
cellchat_wt <- filterCommunication(cellchat_wt, min.cells = 10)
cellchat_wt <- computeCommunProbPathway(cellchat_wt)
cellchat_wt <- aggregateNet(cellchat_wt)


cellchat_vf <- subsetData(cellchat_vf)
cellchat_vf <- identifyOverExpressedGenes(cellchat_vf)
cellchat_vf <- identifyOverExpressedInteractions(cellchat_vf)
cellchat_vf <- computeCommunProb(cellchat_vf)
cellchat_vf <- filterCommunication(cellchat_vf, min.cells = 10)
cellchat_vf <- computeCommunProbPathway(cellchat_vf)
cellchat_vf <- aggregateNet(cellchat_vf)


levels_use <- union(levels(cellchat_wt@idents), levels(cellchat_vf@idents))

cellchat_wt@idents <- factor(cellchat_wt@idents, levels = levels_use)
cellchat_vf@idents <- factor(cellchat_vf@idents, levels = levels_use)

object.list <- list(WT = cellchat_wt, VF = cellchat_vf)
cellchat_merged <- mergeCellChat(object.list, add.names = names(object.list),
                                 cell.prefix = TRUE)
compareInteractions(cellchat_merged, show.legend = FALSE, group = c(1, 2))
compareInteractions(cellchat_merged, show.legend = FALSE, group = c(1, 2), measure = "weight")


weight.max <- getMaxWeight(object.list, attribute = c("idents", "count"))


par(mfrow = c(1,2), xpd = TRUE)
