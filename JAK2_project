# DEGs analysis in MC sub-clusters
DefaultAssay(mc_only) <- "RNA"
Idents(mc_only) <- "celltype_2"
print(table(Idents(mc_only)))

subclusters <- levels(mc_only)
mc_sub_deg_list <- list()

for (sc in subclusters) {
  message("Processing Subcluster: ", sc)
  
  subset_obj <- subset(mc_only, idents = sc)
  subset_obj <- JoinLayers(subset_obj, assay = "RNA")
  
  Idents(subset_obj) <- "genotype"
  
  num_vf <- sum(subset_obj$genotype == "VF")
  num_wt <- sum(subset_obj$genotype == "WT")
  
 
  if (num_vf < 3 | num_wt < 3) {
    message("Skipping ", sc, " (Not enough cells: VF=", num_vf, ", WT=", num_wt, ")")
    next
  }
  
  deg <- tryCatch({
   
    FindMarkers(subset_obj, ident.1 = "VF", ident.2 = "WT", test.use = "wilcox", logfc.threshold = 0, min.pct = 0)
  }, error = function(e) {
    message("Failed to find markers for: ", sc, " - ", e$message)
    NULL
  })
  
 
  mc_sub_deg_list[[sc]] <- deg
}


mc_sub_deg_summary <- data.frame(
  subcluster = character(),
  up = integer(),
  down = integer(),
  stringsAsFactors = FALSE
)

for (sc in names(mc_sub_deg_list)) {
  deg <- mc_sub_deg_list[[sc]] 
  
  if (!is.null(deg)) {
   
  
    sig_up <- sum(deg$p_val_adj < 0.05 & deg$avg_log2FC > 0)
    sig_down <- sum(deg$p_val_adj < 0.05 & deg$avg_log2FC < 0)
    
    mc_sub_deg_summary <- rbind(mc_sub_deg_summary, data.frame(subcluster = sc, up = sig_up, down = sig_down))
  }
}

deg_long <- pivot_longer(mc_sub_deg_summary, cols = c("up", "down"), names_to = "direction", values_to = "count")


p <- ggplot(deg_long, aes(x = subcluster, y = count, fill = direction)) +
  geom_bar(stat = "identity", position = "dodge") +
  labs(title = "DEGs per MC Subcluster (VF vs WT)", 
       x = "MC Subcluster", 
       y = "Number of DEGs") +
  scale_fill_manual(values = c("up" = "forestgreen", "down" = "steelblue")) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

print(p)

# save the MC sub-clusters DEGs data 
for (ct in names(mc_sub_deg_list)) {
  deg_df <- mc_sub_deg_list[[ct]]
  
  if (!is.null(deg_df)) {
    safe_ct <- gsub("[/\\\\:*?\"<>|]", "_", ct)
    
    write.csv(deg_df, file = paste0("DEG_", safe_ct, ".csv"), row.names = TRUE)
  }
}

