# Pseudo PCA 
Layers(seu_integrated[["SCT"]])
Layers(seu_integrated[["RNA"]])
counts <- GetAssayData(seu_integrated, assay = "SCT", layer = "counts")
samples <- unique(seu_integrated$sample)
pseudo_bulk <- sapply(samples, function(samp) {
  cells <- Cells(seu_integrated)[seu_integrated$sample == samp]
  Matrix::rowSums(counts[, cells, drop = FALSE])
})
pseudo_bulk <- as.matrix(pseudo_bulk)

dge <- DGEList(counts = pseudo_bulk)
dge <- calcNormFactors(dge)
logCPM <- edgeR::cpm(dge, log = TRUE, prior.count = 1)
logCPM_filtered <- logCPM[apply(logCPM, 1, var) > 0, ]

pca <- prcomp(t(logCPM_filtered), scale. = TRUE)

df <- data.frame(pca$x[, 1:2])
df$sample <- rownames(df)
df$group <- ifelse(grepl("s6|s7", df$sample), "VF", "WT")  
df$group <- factor(df$group, levels = c("WT", "VF"))

var_percent <- round(100 * pca$sdev^2 / sum(pca$sdev^2), 1)
ggplot(df, aes(x = PC1, y = PC2, fill = group)) +
  geom_point(aes(color = group), shape = 21, size = 5, stroke = 1.5) +  
  geom_text(aes(label = sample), vjust = -1, color = "black") +
  theme_minimal() +
  labs(title = "Pseudo-bulk PCA",
       x = paste0("PC1 (", var_percent[1], "%)"),
       y = paste0("PC2 (", var_percent[2], "%)")) +
  scale_color_manual(values = c("VF" = "black", "WT" = "black")) +  
  scale_fill_manual(values = c("VF" = "red", "WT" = "cyan4"))      

