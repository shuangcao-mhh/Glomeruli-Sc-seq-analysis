Assays(seu_integrated)
Idents(seu_integrated) <- "celltype"
levels(seu_integrated)

deg_list <- list()
celltypes <- levels(seu_integrated )

for (ct in celltypes) {
  message("Processing: ", ct)
  subset_obj <- subset(seu_integrated , idents = ct)
  subset_obj <- JoinLayers(subset_obj, assay = "RNA")
  Idents(subset_obj) <- "genotype"
  
  # Wilcoxon test
  deg <- tryCatch({
    FindMarkers(subset_obj, ident.1 = "VF", ident.2 = "WT", test.use = "wilcox")
  }, error = function(e) {
    message("Failed: ", ct)
    NULL
  })
  
  deg_list[[ct]] <- deg
}


deg_summary <- data.frame(
  celltype = character(),
  up = integer(),
  down = integer(),
  stringsAsFactors = FALSE
)

for (ct in names(deg_list)) {
  deg <- deg_list[[ct]]
  if (!is.null(deg)) {
    deg$gene <- rownames(deg)
    sig_up <- sum(deg$p_val_adj < 0.05 & deg$avg_log2FC > 0.5)
    sig_down <- sum(deg$p_val_adj < 0.05 & deg$avg_log2FC < -0.5)
    deg_summary <- rbind(deg_summary, data.frame(celltype = ct, up = sig_up, down = sig_down))
  }
}


deg_long <- pivot_longer(deg_summary, cols = c("up", "down"), names_to = "direction", values_to = "count")
ggplot(deg_long, aes(x = celltype, y = count, fill = direction)) +
  geom_bar(stat = "identity", position = "dodge") +
  labs(title = "DEGs per Cell Type (VF vs WT)", x = "Cell Type", y = "# DEGs") +
  scale_fill_manual(values = c("up" = "forestgreen", "down" = "steelblue")) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))


getwd()

for (ct in names(deg_list)) {
